# Copy this file to `.env` and fill in your key. `.env` is gitignored.
# The LLM is only used for the optional exercise-generation fallback; the
# app runs retrieval-only without any key.

# --- Cleanvoice recording enhancement (server-side only) ---
# The app quality-checks each recording locally, then sends scorable audio to
# Cleanvoice for noise removal + normalization before Wav2Vec2 analysis.
CLEANVOICE_API_KEY=your-cleanvoice-key-here
# CLEANVOICE_ENABLED=1
# CLEANVOICE_STRICT=0
# CLEANVOICE_STUDIO_SOUND=0
# CLEANVOICE_HTTP_TIMEOUT=120

# --- Google AI Studio (Gemini) -- the default provider ---
GEMINI_API_KEY=your-gemini-key-here

# Optional overrides (defaults shown):
# EXERCISE_LLM_MODEL=gemini-flash-latest
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MAX_TOKENS=800

# --- To use Qwen instead, set these ---
# DASHSCOPE_API_KEY=your-qwen-key-here
# EXERCISE_LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
